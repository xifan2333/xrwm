amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

min_hk_version = "2.0.0"

fail_fast = false

steps {
  ["rustfmt"] = Builtins.rustfmt
  ["clippy"] {
    glob = List("*.rs")
    check = "cargo clippy --all-targets -- -D warnings"
  }
  ["prettier"] = (Builtins.prettier) {
    glob = List("*.json", "*.jsonc", "*.yaml", "*.yml", "*.md")
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        // Merge commits are exempt, matching commitlint's default ignore behavior.
        check = new CommandSpec {
          effect = "read"
          command = new Command {
            argv = List("bash", "-ec", #"""
              {% raw %}
              header=$(head -n1 "$1")
              header=${header%$'\r'}
              case "$header" in
                'Merge '*) exit 0 ;;
              esac
              exec hk util check-conventional-commit "$1"
              {% endraw %}
              """#, "conventional-commit", "{{commit_msg_file}}")
          }
        }
      }
      ["commit-header-length"] {
        env { ["LC_ALL"] = "C.UTF-8" }
        check = new CommandSpec {
          effect = "read"
          command = new Command {
            argv = List("bash", "-ec", #"""
              {% raw %}
              while IFS= read -r header || [ -n "$header" ]; do
                header=${header%$'\r'}
                case "$header" in
                  \#*) continue ;;
                  'fixup! '*|'squash! '*|'amend! '*|'Merge '*) exit 0 ;;
                esac
                if [ "${#header}" -gt 100 ]; then
                  printf '%s\n' 'Commit header must not exceed 100 characters.' >&2
                  exit 1
                fi
                exit 0
              done < "$1"
              {% endraw %}
              """#, "commit-header-length", "{{commit_msg_file}}")
          }
        }
      }
    }
  }
}
